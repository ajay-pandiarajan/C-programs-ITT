#include <stdio.h>
#include <stdlib.h>

int andXorOr(int a_count, int* a) {
    int max_val = 0;
    
    // Allocate stack memory
    int* stack = (int*)malloc(a_count * sizeof(int));
    int top = -1;

    for (int i = 0; i < a_count; i++) {
        int x = a[i];

        // While top of stack is greater than x, pop and test (stack[top] XOR x)
        while (top >= 0 && stack[top] > x) {
            int val = stack[top] ^ x;
            if (val > max_val) {
                max_val = val;
            }
            top--; // Pop
        }

        // If stack is not empty, top of stack and x form a pair
        if (top >= 0) {
            int val = stack[top] ^ x;
            if (val > max_val) {
                max_val = val;
            }
        }

        // Push current element onto stack
        stack[++top] = x;
    }

    free(stack);
    return max_val;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int* a = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    int result = andXorOr(n, a);
    printf("%d\n", result);

    free(a);
    return 0;
}
