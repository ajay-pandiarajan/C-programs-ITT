#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_OPS 1000000

// Stack structure to store previous string states
typedef struct {
    char** states;
    int top;
} HistoryStack;

void push(HistoryStack* stack, const char* str) {
    stack->top++;
    stack->states[stack->top] = strdup(str);
}

char* pop(HistoryStack* stack) {
    if (stack->top == -1) return NULL;
    char* str = stack->states[stack->top];
    stack->top--;
    return str;
}

int main() {
    int Q;
    if (scanf("%d", &Q) != 1) return 0;

    // Allocate memory for the editor string and stack
    char* S = (char*)malloc(MAX_OPS * sizeof(char));
    S[0] = '\0';
    int s_len = 0;

    HistoryStack history;
    history.states = (char**)malloc(Q * sizeof(char*));
    history.top = -1;

    while (Q--) {
        int type;
        scanf("%d", &type);

        if (type == 1) {
            // Append
            char W[1000001];
            scanf("%s", W);

            // Save state for undo
            push(&history, S);

            // Append W to S
            int w_len = strlen(W);
            strcpy(S + s_len, W);
            s_len += w_len;

        } else if (type == 2) {
            // Delete k characters
            int k;
            scanf("%d", &k);

            // Save state for undo
            push(&history, S);

            // Delete last k characters
            s_len -= k;
            S[s_len] = '\0';

        } else if (type == 3) {
            // Print k-th character (1-indexed)
            int k;
            scanf("%d", &k);
            printf("%c\n", S[k - 1]);

        } else if (type == 4) {
            // Undo
            char* previous_state = pop(&history);
            if (previous_state) {
                strcpy(S, previous_state);
                s_len = strlen(S);
                free(previous_state);
            }
        }
    }

    // Clean up remaining stack memory
    while (history.top >= 0) {
        free(history.states[history.top--]);
    }
    free(history.states);
    free(S);

    return 0;
}
